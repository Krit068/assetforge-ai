# Backend
ASSETFORGE_APP_ENV=local
ASSETFORGE_DEFAULT_LOCALE=zh-CN
ASSETFORGE_SUPPORTED_LOCALES=zh-CN,en
ASSETFORGE_API_PREFIX=/api/v1
# Local scaffold fallback. Switch to postgresql+psycopg://... before persistent Alpha acceptance.
ASSETFORGE_DATABASE_URL=sqlite:///./data/assetforge.db
ASSETFORGE_MODEL_PROVIDER=mock
ASSETFORGE_MODEL_API_BASE_URL=https://tokenhub.tencentmaas.com
ASSETFORGE_MODEL_API_KEY=
ASSETFORGE_MODEL_NAME=tripo-3d-p1
# Tripo 官方 API 与 TokenHub 使用独立密钥；官方 Key 以 tsk_ 开头。
ASSETFORGE_TRIPO_API_BASE_URL=https://api.tripo3d.ai/v2/openapi
ASSETFORGE_TRIPO_API_KEY=
ASSETFORGE_TRIPO_MODEL_VERSION=P1-20260311
ASSETFORGE_IMAGE_MODEL_NAME=seedream-image-v5.0-pro
ASSETFORGE_MODEL_TIMEOUT_SECONDS=900
ASSETFORGE_IMAGE_MODEL_TIMEOUT_SECONDS=180
ASSETFORGE_IMAGE_MODEL_MAX_RETRIES=0
ASSETFORGE_MODEL_MAX_RETRIES=2
ASSETFORGE_ASSET_STORAGE_ROOT=./data
ASSETFORGE_PUBLIC_BASE_URL=http://localhost:8010
ASSETFORGE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://assetforge-alpha.mornoxborn89.chatgpt.site
ASSETFORGE_MAX_MODEL_FILE_MB=500
ASSETFORGE_MAX_REFERENCE_IMAGE_MB=20
ASSETFORGE_MAX_REFERENCE_IMAGE_DIMENSION=8192
ASSETFORGE_MAX_CONCEPT_IMAGE_MB=20
ASSETFORGE_INTERNAL_COST_TRACKING=true

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8010/api/v1
